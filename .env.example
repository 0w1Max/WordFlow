# Turso (libSQL) — получить через `turso db show <db-name> --url` и
# `turso db tokens create <db-name>`, либо через интеграцию Turso
# в Vercel Marketplace (она проставит эти переменные автоматически).
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Секрет для подписи JWT-токенов авторизации. ОБЯЗАТЕЛЬНО задайте своё
# случайное значение перед деплоем в прод, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# Sentry (мониторинг ошибок) — необязательно. Без этой переменной приложение
# работает как раньше, просто без отправки ошибок в Sentry.
# Получить на sentry.io → Create Project → Node.js/Express → Client Keys (DSN)
SENTRY_DSN=

# Resend (email для восстановления пароля) — необязательно. Без этой
# переменной ссылка для сброса пароля просто печатается в консоль сервера
# вместо отправки письма (удобно для локальной разработки).
# Получить на resend.com → API Keys
RESEND_API_KEY=
# Адрес отправителя. Без своего домена в Resend можно слать только с
# onboarding@resend.dev — этого достаточно для теста.
RESEND_FROM_EMAIL=WordFlow <onboarding@resend.dev>

# Только для локального запуска через `node server.js` — на Vercel
# порт назначается платформой автоматически, эта переменная не используется.
PORT=3000

# Раскомментируйте в проде — включает флаг Secure у auth-cookie
# (кука будет отправляться только по HTTPS, что Vercel обеспечивает всегда).
# NODE_ENV=production
