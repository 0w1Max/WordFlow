# Turso (libSQL) — получить через `turso db show <db-name> --url` и
# `turso db tokens create <db-name>`, либо через интеграцию Turso
# в Vercel Marketplace (она проставит эти переменные автоматически).
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Секрет для подписи JWT-токенов авторизации. ОБЯЗАТЕЛЬНО задайте своё
# случайное значение перед деплоем в прод, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# Только для локального запуска через `node server.js` — на Vercel
# порт назначается платформой автоматически, эта переменная не используется.
PORT=3000

# Раскомментируйте в проде — включает флаг Secure у auth-cookie
# (кука будет отправляться только по HTTPS, что Vercel обеспечивает всегда).
# NODE_ENV=production
