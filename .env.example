# Turso (libSQL) — получить через `turso db show <db-name> --url` и
# `turso db tokens create <db-name>`, либо через интеграцию Turso
# в Vercel Marketplace (она проставит эти переменные автоматически).
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Только для локального запуска через `node server.js` — на Vercel
# порт назначается платформой автоматически, эта переменная не используется.
PORT=3000
